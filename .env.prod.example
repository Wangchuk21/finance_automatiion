# =============================================================================
# Finance Automation — Production Environment
# =============================================================================
# Copy this file to .env.prod and fill in ALL values before deploying.
#   cp .env.prod.example .env.prod
#
# Generate secrets with:
#   openssl rand -base64 32
# =============================================================================

# ── REQUIRED SECRETS ─────────────────────────────────────────────────────────
# JWT signing key (min 32 chars). Generate: openssl rand -base64 32
SECRET_KEY=CHANGE_ME

# Salt for anonymizing PII in logs (min 16 chars). Generate: openssl rand -base64 32
ANONYMIZATION_SALT=CHANGE_ME

# Confirmation code for sensitive operations (close contract, etc.)
# Replace with a strong code; this is a temporary measure before TOTP is implemented.
TEMP_CONFIRM_CODE=CHANGE_ME

# ── DATABASE ─────────────────────────────────────────────────────────────────
POSTGRES_DB=finance
POSTGRES_USER=finance
# Strong password (16+ chars, mix of letters/numbers/symbols)
POSTGRES_PASSWORD=CHANGE_ME

# ── DOMAIN ───────────────────────────────────────────────────────────────────
# Your server's domain or IP. Used for CORS, SSL, nginx, and login links in
# emails (https://<DOMAIN>/login).
# Examples: finance.bt.bt   or   10.1.2.3
DOMAIN=CHANGE_ME

# Optional: override the frontend URL used in emails. Leave unset to use
# https://<DOMAIN> in production.
# FRONTEND_URL=https://finance.bt.bt

# ── SMTP (Email Notifications) ──────────────────────────────────────────────
SMTP_HOST=smtp11.bt.bt
SMTP_PORT=465
SMTP_USER=finance.notification@bt.bt
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM="Finance Notification <finance.notification@bt.bt>"

# ── SMS Gateway (Bhutan Telecom) ─────────────────────────────────────────────
# Set SMS_ENABLED=true once the gateway URL and API key are provided by BT IT.
SMS_ENABLED=false
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID=BTL-EMI

# ── APP SETTINGS ─────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
LOG_LEVEL=info
MAX_UPLOAD_SIZE_MB=50
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cookie security (true when using HTTPS)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=https://CHANGE_ME

# ── OPTIONAL — Monitoring ────────────────────────────────────────────────────
# SENTRY_DSN=
# PROMETHEUS_ENABLED=false
