# Application
APP_NAME="Finance Automation"
APP_ENV=dev
DEBUG=true
LOG_LEVEL=info

# Temporary confirmation code (dev only – replace with TOTP in production)
TEMP_CONFIRM_CODE=123456

# Database (PostgreSQL) — must match docker-compose.yml postgres service
DATABASE_URL=postgresql+asyncpg://finance_dev:finance_dev_pass@localhost:5432/finance_automation
DATABASE_URL_SYNC=postgresql+psycopg2://finance_dev:finance_dev_pass@localhost:5432/finance_automation

# Security — generate a real key for production: openssl rand -base64 32
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# SMTP (configure for real notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=changeme
SMTP_FROM=Finance Automation <notifications@example.com>

# Anonymization — generate a real salt for production: openssl rand -base64 32
ANONYMIZATION_SALT=dev-anonymization-salt-change-in-production

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
