# Application
APP_NAME="Finance Automation"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/finance_automation
# For sync operations (alembic)
DATABASE_URL_SYNC=postgresql+psycopg2://user:password@localhost:5432/finance_automation
# For psycopg3 async driver (used internally)
# DATABASE_URL_ASYNC=postgresql+psycopg://user:password@localhost:5432/finance_automation

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Notification (example SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=changeme
SMTP_FROM=Finance Automation <notifications@example.com>

# Anonymization
ANONYMIZATION_SALT=change-this-salt-in-production